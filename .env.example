# =============================================================================
# Server — copy this file to server/.env
# =============================================================================
PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/aptitude-app

# Production: use at least 32 random characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Comma-separated allowed browser origins (must match where the UI is opened)
CLIENT_ORIGIN=http://localhost:5173

# Primary super admin (created on server start; use npm run reset:db for a clean database)
SUPER_ADMIN_EMAIL=admin@aptitude.com
SUPER_ADMIN_PASSWORD=Admin@123
SUPER_ADMIN_NAME=Admin
# Production: set true only when you need to reset the super-admin password once
SUPER_ADMIN_SYNC_PASSWORD=false

# =============================================================================
# Client (development) — copy to client/.env.local
# Leave VITE_API_URL unset in production when the API serves client/dist
# =============================================================================
# VITE_API_URL=http://localhost:5000

# =============================================================================
# Production (single host)
# 1. cd client && npm run build
# 2. Set NODE_ENV=production in server/.env
# 3. cd server && npm start
# The API serves the built UI and uses same-origin cookies (no VITE_API_URL).
# =============================================================================
